    {
      "parameters": {
        "promptType": "define",
        "text": "=حلل صورة كشف الدرجات المرفقة واستخرج اسم كل طالب ودرجاته في مادة الإنجليزي والعربي والرياضيات. أعد النتيجة بصيغة JSON فقط.",
        "options": {
          "systemMessage": "You are an expert OCR data-extraction assistant for student grade sheets.\nThe user sends an image of a table containing student names and their grades in English, Arabic, and Math.\nAnalyze the ATTACHED IMAGE and extract every student row precisely.\n\nReturn ONLY valid JSON — no markdown, no code fences, no explanations — in exactly this structure:\n{\n  \"students\": [\n    { \"name\": \"Student full name\", \"english\": 0, \"arabic\": 0, \"math\": 0 }\n  ]\n}\n\nRules:\n- Use numbers (not strings) for english, arabic and math.\n- If a grade is missing or unreadable, use null.\n- Include exactly one object per student.",
          "passthroughBinaryImages": true
        }
      },
      "id": "5fe79678-b702-4887-be60-d682fdbd6b3d",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        448,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\n\nlet parsed;\n\n// إذا كان Object بالفعل\nif (typeof raw === \"object\") {\n  parsed = raw;\n} else {\n  let text = String(raw).trim();\n\n  // إزالة Markdown إن وجد\n  text = text.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n\n  // إذا كان النص يحتوي على escape characters\n  if (text.startsWith('\"') && text.endsWith('\"')) {\n    text = JSON.parse(text);\n  }\n\n  parsed = JSON.parse(text);\n}\n\nconst students = Array.isArray(parsed)\n  ? parsed\n  : (parsed.students || []);\n\nif (!students.length) {\n  throw new Error(\"No students found in AI output\");\n}\n\nconst toNum = (v) => {\n  if (v === null || v === undefined || v === \"\") return null;\n  const n = Number(v);\n  return isNaN(n) ? null : n;\n};\n\nreturn students.map((s) => ({\n  json: {\n    \"الاسم\": s.name ?? s[\"الاسم\"] ?? null,\n    \"الإنجليزي\": toNum(s.english ?? s[\"الإنجليزي\"]),\n    \"العربي\": toNum(s.arabic ?? s[\"العربي\"]),\n    \"الرياضيات\": toNum(s.math ?? s[\"الرياضيات\"]),\n  },\n}));"
      },
